FLASK_ENV=development
SECRET_KEY=replace-with-strong-secret
DATABASE_URL=sqlite:///app.db
JWT_SECRET_KEY=replace-with-jwt-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=200
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
SIMULATION_MODE=true
SIM_API_BASE_URL=http://127.0.0.1:5000/api/v1
SIM_INGEST_INTERVAL_SECONDS=5
SIM_HEARTBEAT_INTERVAL_SECONDS=30
SIM_DATA_INTERVAL=5
SIM_HEARTBEAT_INTERVAL=30
SIM_COMPANY_NAME=Simulation Plant
AI_FAILURE_THRESHOLD=65
AI_HEALTH_THRESHOLD=60
AI_DEGRADATION_THRESHOLD=70
EXPORT_BASE_DIR=generated_reports
CACHE_DEFAULT_TTL_SECONDS=300
REPORT_CACHE_TTL_SECONDS=900
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_SECRET=replace-with-razorpay-secret
ALERT_ESCALATION_MINUTES=10
DEFAULT_TIMEZONE=UTC
SEED_ON_START=true
ALLOW_RESEED=false
SEED_USER_PASSWORD=Welcome#2026
