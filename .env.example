FLASK_ENV=development
SECRET_KEY=replace-with-strong-secret
DATABASE_URL=sqlite:///app.db
GEMINI_API_KEY=replace-with-gemini-api-key

# Simulation and ingest
SIMULATION_MODE=true
SIM_API_BASE_URL=http://127.0.0.1:5000/api/v1
SIM_INGEST_INTERVAL_SECONDS=5
SIM_HEARTBEAT_INTERVAL_SECONDS=30
SIM_DATA_INTERVAL=5
SIM_HEARTBEAT_INTERVAL=30
SIM_COMPANY_NAME=Simulation Plant

# Mail
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=alerts@monitoring.local

# Alerts and time
ALERT_ESCALATION_MINUTES=10
DEFAULT_TIMEZONE=UTC
